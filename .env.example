# Validation provider for US addresses. Options: google, smarty (defaults to smarty)
DOMESTIC_VALIDATION_PROVIDER=smarty

# Validation provider for addresses outside the US. Options: google, smarty (defaults to smarty)
INTERNATIONAL_VALIDATION_PROVIDER=smarty

# Required when Google is selected for either provider
GOOGLE_MAPS_API_KEY=your-google-api-key-here

# Required when Smarty is selected for either provider
SMARTY_AUTH_ID=your-smarty-auth-id-here
SMARTY_AUTH_TOKEN=your-smarty-auth-token-here

# Optional: browser-only key; this server uses the Auth ID and token above
SMARTY_EMBEDDED_KEY=your-smarty-embedded-key-here

# Required: comma-separated list of storefront origins allowed to call this API
ALLOWED_ORIGINS=https://*.mybrightsites.com,https://thespianshop.org,https://shop.forbestravelguide.com,https://sheratonshop.com,https://ryderrecognition.com,https://redeem.forbestravelguide.com,https://phikappaphistore.org,https://marriottbrandsstore.com,https://fcclastore.org,https://cookierewards.su.centricitynow.com,https://cookierewards.sl.centricitynow.com,https://centricitycollection.com,https://asestore.com,https://allritzstore.com

# Optional: port to listen on (Heroku sets PORT automatically)
PORT=3000

# Optional: rate limiting per client IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional: timeout for calls to the Google Address Validation API
GOOGLE_API_TIMEOUT_MS=10000
